<a href="https://wa.me/254700000000" style="display:block;background:#25D366;color:#fff;padding:12px;border-radius:25px;text-decoration:none;font-weight:bold;margin:10px 0">Send on WhatsApp</a>
<button onclick="closeP()" style="border:none;background:none;color:grey">Close</button>
</div></div>
