<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>chapchap. Nakuru - 30 min</title>
<style>*{margin:0;padding:0;box-sizing:border-box;font-family:system-ui}body{background:#fffef5;padding-bottom:380px}header{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;background:white;position:sticky;top:0;z-index:10;box-shadow:0 1px 4px #0001}.logo{font-weight:900;font-size:22px}.logo span{color:#f59e0b}.cart-btn{background:#fbbf24;border:none;padding:10px 18px;border-radius:20px;font-weight:700}.hero{padding:8px 16px;color:#666;font-size:13px}.order-now{background:#fbbf24;border:none;padding:10px 18px;border-radius:20px;font-weight:700;margin:8px 16px}.card{background:white;border-radius:16px;padding:12px;margin:12px 16px;box-shadow:0 2px 10px #0001}.steps{display:flex;gap:8px;overflow-x:auto}.step{min-width:110px;border-left:4px solid #10b981;padding:6px 10px;background:#f9fafb;border-radius:8px}.grid{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin:10px 16px}.rest{background:white;border-radius:14px;overflow:hidden;box-shadow:0 2px 8px #0001}.rest img{width:100%;height:90px;object-fit:cover}.rest b{padding:6px 8px;display:block}.menu-item{display:flex;justify-content:space-between;align-items:center;background:white;margin:8px 16px;padding:14px;border-radius:12px;box-shadow:0 1px 5px #0001}.add{background:#fbbf24;border:none;padding:10px 18px;border-radius:20px;font-weight:700;font-size:15px}#cartDrawer{position:fixed;bottom:0;left:0;right:0;background:white;border-top:4px solid #fbbf24;border-radius:20px 20px 0 0;padding:14px;max-height:70vh;overflow:auto;box-shadow:0 -5px 20px #0003;z-index:1000}input{width:100%;padding:12px;border:1px solid #ddd;border-radius:10px;margin:6px 0}.btn{width:100%;padding:13px;border:none;border-radius:10px;font-weight:800;margin:6px 0}.green{background:#16a34a;color:white}.blue{background:#2563eb;color:white}.outline{background:white;border:2px solid #2563eb;color:#2563eb}</style>
</head>
<body>
<header><div class="logo">chap<span>chap</span>.</div><div style="font-size:12px">Nakuru - 30 min</div><button class="cart-btn">Cart (<span id="cartCount">0</span>) Ksh <span id="cartTotalH">0</span></button></header>
<div class="hero">Pay directly with M-Pesa Till or PayPal - No WhatsApp chat needed.</div>
<button class="order-now" onclick="document.getElementById('menu').scrollIntoView({behavior:'smooth'})">Order Now</button>
<div class="card"><div style="display:flex;justify-content:space-between"><b>How it works</b><span style="background:#fbbf24;padding:2px 8px;border-radius:10px;font-size:11px">Direct Pay</span></div><div class="steps" style="margin-top:10px"><div class="step"><b>1. Browse</b><br><small>Menu</small></div><div class="step" style="border-color:#fbbf24"><b>2. Add Cart</b><br><small>Chips etc</small></div><div class="step" style="border-color:#111"><b>3. Pay Direct</b><br><small>Till / PayPal</small></div><div class="step"><b>4. Deliver</b><br><small>30 mins</small></div></div></div>
<div style="padding:0 16px;font-weight:700">Popular Restaurants</div>
<div class="grid"><div class="rest"><img src="https://images.unsplash.com/photo-1517248135467-4c7edcad34c4"><b>Java House<br><small style="font-weight:400">4.8 - 25 min</small></b></div><div class="rest"><img src="https://images.unsplash.com/photo-1552566626-52f8b828add9"><b>Annex Grill<br><small style="font-weight:400">4.7 - 20 min</small></b></div><div class="rest"><img src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0"><b>Merica Hotel<br><small style="font-weight:400">4.6 - 30 min</small></b></div><div class="rest"><img src="https://images.unsplash.com/photo-1565557623262-b51c2513a641"><b>Chicken Inn<br><small style="font-weight:400">4.9 - 18 min</small></b></div></div>
<div id="menu" style="padding:10px 16px;font-weight:700;margin-top:10px">Today Menu - Nakuru Town - TAP ADD 👇</div>
<div id="menuList"></div>
<div id="cartDrawer"><div style="display:flex;justify-content:space-between"><b>Your Cart</b><b>Ksh <span id="cartTotal">0</span></b></div><div id="cartItems" style="font-size:13px;color:#666;margin:6px 0">Empty - TAP ADD button on foods above first 👆</div><div style="border:2px solid #fbbf24;border-radius:14px;padding:10px;margin-top:10px"><b>Pay Directly - No WhatsApp</b><div style="margin-top:8px;color:#16a34a;font-weight:800">M-Pesa Till: 0101133704</div><small>1. M-Pesa - Buy Goods<br>2. Till: 0101133704 Amount: <b>Ksh <span class="amt">0</span></b><br>3. Paste Code below</small><input id="mpesaCode" placeholder="e.g. QGH7X9K2L1"><input id="phone" placeholder="Your Phone 07xx" value="0720699038"><input id="loc" placeholder="Location e.g. Lanet, Sec 58" value="Nakuru"><button class="btn green" onclick="confirmMpesa()">I Have Paid - Confirm Order (Till)</button><div style="margin-top:14px;background:#f1f5f9;padding:10px;border-radius:10px"><div style="color:#2563eb;font-weight:800">PayPal / Card</div><small>Auto $: $<span class="usd">0</span></small><a id="paypalLink" target="_blank" href="https://www.paypal.com/paypalme/tesla9stock/1"><button class="btn blue">Pay with PayPal / Card</button></a><button class="btn outline" onclick="confirmPaypal()">I Paid PayPal - Confirm</button></div><div style="margin-top:10px"><label><input type="checkbox" id="cod"> Cash on Delivery</label></div><button class="btn" style="background:#111;color:white;margin-top:8px" onclick="confirmCOD()">Confirm Cash Order</button></div></div>
<script>
const foods=[{name:"Chicken & Chips",price:450,img:"https://images.unsplash.com/photo-1565557623262-b51c2513a641"},{name:"Fries + Soda",price:250,img:"https://images.unsplash.com/photo-1573080496219-bb080dd4f877"},{name:"Burger & Chips",price:380,img:"https://images.unsplash.com/photo-1568909344668-6f14a07b56a0"},{name:"Pilau Kuku",price:500,img:"https://images.unsplash.com/photo-1565557623262-b51c2513a641"}];
let cart=[];function renderMenu(){let h="";foods.forEach((f,i)=>{h+=`<div class="menu-item"><div style="display:flex;gap:8px;align-items:center"><img src="${f.img}" style="width:55px;height:55px;border-radius:8px;object-fit:cover"><div><b>${f.name}</b><br>Ksh ${f.price}</div></div><button class="add" onclick="addCart(${i})">Add</button></div>`;});document.getElementById("menuList").innerHTML=h;}
function addCart(i){cart.push(foods[i]);updateCart();alert(foods[i].name+" added! Cart: "+cart.length);}
function updateCart(){let total=0;let list="";cart.forEach(c=>{total+=c.price;list+=c.name+" - "+c.price+"<br>"});if(cart.length==0)list="Empty - TAP ADD button on foods above first 👆";document.getElementById("cartItems").innerHTML=list;document.getElementById("cartTotal").innerText=total;document.getElementById("cartTotalH").innerText=total;document.getElementById("cartCount").innerText=cart.length;document.querySelectorAll(".amt").forEach(e=>e.innerText=total);document.querySelectorAll(".usd").forEach(e=>e.innerText=(total/130).toFixed(2));let paypalAmt=Math.ceil(total/130);if(paypalAmt<1)paypalAmt=1;document.getElementById("paypalLink").href=`https://www.paypal.com/paypalme/tesla9stock/${paypalAmt}`;}
function getOrderText(method,code){let items=cart.map(c=>c.name).join(", ");let total=document.getElementById("cartTotal").innerText;let phone=document.getElementById("phone").value||"Not provided";let loc=document.getElementById("loc").value||"Not provided";return `NEW ORDER - ChapChap Nakuru%0A%0AMethod: ${method}%0ACode: ${code}%0ATotal: Ksh ${total}%0AItems: ${items}%0APhone: ${phone}%0ALocation: ${loc}`;}
function confirmMpesa(){if(cart.length==0){alert("❌ TAP ADD first - Cart empty!");return;}let code=document.getElementById("mpesaCode").value.trim();let phone=document.getElementById("phone").value.trim();let loc=document.getElementById("loc").value.trim();if(code.length<3){alert("❌ Enter M-Pesa code or TEST123");return;}if(phone.length<9){alert("❌ Enter phone");return;}if(loc.length<2){alert("❌ Enter location");return;}let text=getOrderText("M-Pesa Till 0101133704",code);window.open(`https://wa.me/254745064401?text=${text}`,"_blank");alert("✅ Order sent!");}
function confirmPaypal(){if(cart.length==0){alert("❌ TAP ADD first");return;}let text=getOrderText("PayPal","PAID");window.open(`https://wa.me/254745064401?text=${text}`,"_blank");}
function confirmCOD(){if(cart.length==0){alert("❌ TAP ADD first");return;}if(!document.getElementById("cod").checked){alert("❌ Tick Cash box");return;}let text=getOrderText("Cash on Delivery","CASH");window.open(`https://wa.me/254745064401?text=${text}`,"_blank");}
renderMenu();
</script>
</body>
</html>
