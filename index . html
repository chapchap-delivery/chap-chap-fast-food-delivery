.card{background:#fff;border-radius:15px;overflow:hidden;text-align:center;box-shadow:0 2px 8px rgba(0,0,0,.1)}
.card img{width:100%;height:150px;object-fit:cover}
.card button{margin:8px;background:#111;color:#fff;border:none;padding:6px 12px;border-radius:20px}
.pricing{padding:20px;text-align:center}
.pbox{background:#fff;border:2px solid #ff9eb5;border-radius:15px;padding:15px;margin:10px 0}
#pay{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.7);display:none;align-items:center;justify-content:center;padding:15px}
.modal{background:#fff;border-radius:20px;padding:20px;width:100%;max-width:360px;text-align:center}
.mpesa{background:#1eb344;color:#fff;padding:12px;border-radius:10px;margin:10px 0;font-weight:bold}
